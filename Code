 waves.forEach((w,i)=>{const k=((t-16.4-i*.45)%1.35+1.35)%1.35/1.35,on=win(t,16.4,19.4,.1);w.scale.setScalar(2+k*9);w.position.z=3.5+k*3;w.material.opacity=on*(1-k)*.7});
 // person
 per.visible=t>4.8&&t<15.6;const talk=BUB.some(b=>t>b[0]&&t<b[1]);mouth.scale.y=talk?1+1.8*Math.abs(Math.sin(t*14)):1;
 // camera
 if(!drag)off*=.96;
 const [cp,ct]=camAt(t),px=cp[0]+4.5*Math.sin((t-21)*.5)*ex-ct[0],pz=cp[2]-ct[2],ca=Math.cos(off),sa=Math.sin(off);
 cam.position.set(ct[0]+px*ca+pz*sa,cp[1],ct[2]+s.z-px*sa+pz*ca);cam.lookAt(ct[0],ct[1],ct[2]+s.z);
 cam.updateMatrixWorld();
