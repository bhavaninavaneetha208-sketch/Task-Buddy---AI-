#note b{display:block;font-size:calc(var(--u)*2.2)}#note small{color:#566271}
#end{position:absolute;left:0;right:0;bottom:8%;text-align:center;opacity:0}
#end h2{margin:0;font-size:calc(var(--u)*3.6);font-weight:700}
#end h2 i{font-style:normal;color:var(--acc)}
#end p{margin:.5em 0 0;font-size:calc(var(--u)*1.8);color:#aab4c0}
#bar{display:flex;gap:10px;align-items:center;width:min(100vw,calc((100vh - 60px)*16/9));padding:0 8px;box-sizing:border-box}
button{background:#1b222c;color:var(--ink);border:1px solid #33404f;border-radius:8px;padding:8px 12px;font:inherit;font-size:14px;min-height:36px;cursor:pointer}
button:focus-visible,input:focus-visible{outline:2px solid var(--acc);outline-offset:2px}
input[type=range]{flex:1;accent-color:var(--acc)}
#tm{font-variant-numeric:tabular-nums;font-size:13px;color:#aab4c0;min-width:42px}
</style></head><body>
<div id="wrap"><div id="stage"><canvas id="c"></canvas><div id="ov">
<div id="title"><h1></h1><p></p></div><div id="bub"></div>
<div id="note"><span style="font-size:2.4em">🔔</span><span><small>Reminder</small><b>Study at 7 PM</b></span></div>
