#ov{position:absolute;inset:0;pointer-events:none;font-size:max(9px,calc(var(--u)*1.35))}
.lb{position:absolute;left:0;top:0;white-space:nowrap;opacity:0;font-weight:600;letter-spacing:.01em;text-shadow:0 1px 4px #000}
.lb:before{content:"";position:absolute;width:.55em;height:.55em;border-radius:50%;background:var(--acc);top:50%;margin-top:-.28em}
.lb.L{padding-right:1em;margin-left:-1.2em}.lb.L:before{right:0}
.lb.R{padding-left:1em}.lb.R:before{left:0}
.lb.T,.lb.B{text-align:center}
#title{position:absolute;left:4%;bottom:7%;opacity:0}
#title h1{margin:0;font-size:calc(var(--u)*4.6);font-weight:700;letter-spacing:-.02em;line-height:1.05}
#title p{margin:.4em 0 0;font-size:calc(var(--u)*1.7);color:#aab4c0}
#bub{position:absolute;left:0;top:0;opacity:0;background:#f4f6f8;color:#10151c;font-weight:700;font-size:calc(var(--u)*1.9);padding:.35em .8em;border-radius:1em 1em 1em .2em;white-space:nowrap}
