 labs.forEach(l=>{const[x,y]=proj(l.o),a=lab*ss(0,.5,lab*1+0)*cl((lab*10-l.i*.6),0,1);l.d.style.opacity=a;
  const tf={L:'translate(-100%,-50%)',R:'translate(0,-50%)',T:'translate(-50%,-190%)',B:'translate(-50%,90%)'}[l.s];
