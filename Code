const eyeM=new T.MeshBasicMaterial({color:0x4fe3ff,transparent:true});
const eyes=[-1.5,1.5].map(x=>{const e=new T.Mesh(new T.CircleGeometry(.75,24),eyeM);e.position.set(x,15.5,3.36);shell.add(e);return e});
for(let i=0;i<5;i++)shell.add(mesh(new T.BoxGeometry(4.6,.28,.2),dark,[0,10.6-i*.75,3.35],false));
const stM=new T.MeshBasicMaterial({color:0x44ff88,transparent:true});
const stLed=new T.Mesh(new T.SphereGeometry(.32,16,12),stM);stLed.position.set(2.7,12.7,3.35);shell.add(stLed);
const micHole=mesh(new T.CircleGeometry(.75,24),dark,[0,19.52,1.2],false);micHole.rotation.x=-Math.PI/2;shell.add(micHole);
const micRing=mesh(new T.RingGeometry(.85,1.05,24),M(0x8a929c,.3,.6),[0,19.51,1.2],false);micRing.rotation.x=-Math.PI/2;shell.add(micRing);
shell.add(bx(.6,1.5,1,0x1b1f26,[5.2,12.5,-1.2]),bx(.3,.8,.5,0xd33,[5.55,12.8,-1.2]));
shell.add(mesh(new T.SphereGeometry(.85,16,12),M(0xb8c0ca,.3,.8),[0,.85,2.4]),cyl(.3,.6,0x8a929c,[0,1.5,2.4]));
const shellMats=new Set();shell.traverse(o=>{if(o.material&&o!==edges)shellMats.add(o.material)});
const rear=new T.Group();robot.add(rear);rear.add(bx(6.4,11.5,.4,0xcfd5dd,[0,9.8,-3.55]));
[[-2.6,4.6],[2.6,4.6],[-2.6,-4.6],[2.6,-4.6]].forEach(p=>rear.add(cyl(.28,.3,0x6d7681,[p[0],9.8+p[1],-3.85],'z')));
const rearAnc=new T.Object3D();rearAnc.position.set(3.2,9.8,-3.5);rear.add(rearAnc);
const shAnc=new T.Object3D();shAnc.position.set(0,20,0);shell.add(shAnc);
// wheels
const wheels=[1,-1].map(s=>{const g=new T.Group(),p=new T.Group();g.add(p);
 p.add(cyl(3,1.6,0x14171c,[0,0,0],'x'),cyl(1.2,1.8,0x8a929c,[0,0,0],'x'));
 for(let i=0;i<6;i++){const a=i*Math.PI/3,b=bx(.3,.5,.4,0x2a2f37,[0,Math.sin(a)*3,Math.cos(a)*3]);b.rotation.x=-a;p.add(b)}
 g.add(cyl(.35,1.8,0x8a929c,[-s*.9,0,0],'x'));g.position.set(s*6.6,3,0);g.userData={a:[s*6.6,3,0],e:[s*22,4,0],p};robot.add(g);return g});
// components
const comps=[];
function add(name,g,a,e,side){g.position.set(...a);robot.add(g);comps.push({name,g,a,e,side})}
function grp(...c){const g=new T.Group();c.forEach(x=>g.add(x));return g}
const sph=(r,c,p)=>new T.Mesh(new T.SphereGeometry(r,12,10),new T.MeshBasicMaterial({color:c})).translateX(p[0]).translateY(p[1]).translateZ(p[2]);
add('ESP32',grp(bx(2.6,5,.25,0x1c1f26),bx(1.6,1.8,.3,0xb8c0ca,[0,.6,.1]),bx(2,.8,.2,0xc9a24a,[0,2.2,.05])),[-1.5,11.5,-1.5],[-14,26,0],'L');
add('Offline voice-recognition module',grp(bx(3,2.4,.25,0x1f7a45),bx(1.2,1.2,.3,0x111,[0,0,.1]),bx(.8,.5,.3,0xb8c0ca,[1,-.8,.1])),[2,11.5,-1.5],[14,26,0],'R');
add('Microphone',grp(cyl(.55,1.2,0x20242b,[0,0,0],'z'),cyl(.4,.3,0xb8c0ca,[0,0,.7],'z')),[0,18.4,1.2],[0,32,1],'T');
add('Motor driver',grp(bx(4.5,3,.25,0xb02323),bx(1.4,1.4,.3,0x111,[-.8,0,.1]),bx(1.2,.9,.8,0x2b6fd1,[1.4,.8,.3])),[0,6.5,-1.5],[-14,15,0],'L');
add('Geared motor (left)',grp(cyl(1.5,3.2,0xe5b923,[0,0,0],'x'),bx(1.6,3,3,0xe5b923,[1.8,0,0]),cyl(.35,1,0x8a929c,[3.1,0,0],'x')),[3,3,-.5],[-14,4,0],'L');
add('Geared motor (right)',grp(cyl(1.5,3.2,0xe5b923,[0,0,0],'x'),bx(1.6,3,3,0xe5b923,[-1.8,0,0]),cyl(.35,1,0x8a929c,[-3.1,0,0],'x')),[-3,3,-.5],[14,4,0],'R');
add('Speaker / audio module',grp(cyl(1.8,1,0x20242b,[0,0,0],'z'),cyl(.8,1.1,0x555c66,[0,0,0],'z'),bx(1.6,1.6,.2,0x1f7a45,[0,-2.4,-.6])),[0,9,2],[14,15,0],'R');
add('LEDs',grp(sph(.35,0x4fe3ff,[-1.5,0,0]),sph(.35,0x4fe3ff,[1.5,0,0]),sph(.32,0x44ff88,[2.7,-2.8,0])),[0,15.5,2.4],[14,35,0],'R');
add('Buzzer',cyl(1,1,0x111111,[0,0,0],'z'),[2.6,14.2,.2],[-14,35,0],'L');
add('Battery compartment',grp(bx(6,3,3,0x2a2f37),bx(5.2,.4,2.4,0x14171c,[0,1.6,0]),bx(.5,.5,.5,0xc22,[2,1.9,0])),[0,3.4,-.5],[0,-4,0],'B');
const labs=[...comps.map(c=>({n:c.name,o:c.g,s:c.side,k:c.e[1]})),{n:'Outer shell',o:shAnc,s:'T'},{n:'Removable rear panel',o:rearAnc,s:'R'}];
labs.forEach((l,i)=>{const d=document.createElement('div');d.className='lb '+l.s;d.textContent=l.n;$('ov').appendChild(d);l.d=d;l.i=i});
// person (stylised scale)
const per=new T.Group(),skin=M(0xe0b08c,.7),shirt=M(0x3b6ea8,.8),pant=M(0x252a33,.8);
[-1.7,1.7].forEach(x=>per.add(mesh(new T.CylinderGeometry(1.5,1.5,14,12),pant,[x,7,0])));
per.add(mesh(new T.BoxGeometry(8,11,4.2),shirt,[0,19.5,0]));
[-5,5].forEach(x=>per.add(mesh(new T.CylinderGeometry(1.2,1.2,10,10),shirt,[x,19,0])));
const head=mesh(new T.SphereGeometry(3.3,20,16),skin,[0,28.5,0]);per.add(head);
const mouth=bx(1.6,.5,.4,0x5a2020,[0,27.6,3.1]);per.add(mouth);
per.add(bx(.7,.7,.4,0x222,[-1.2,29.2,3.1]),bx(.7,.7,.4,0x222,[1.2,29.2,3.1]));
per.position.set(-22,0,-12);per.rotation.y=1.1;S.add(per);
// highlights
const hiM=new T.MeshBasicMaterial({color:0xffb547,transparent:true,opacity:0});
const micHi=new T.Mesh(new T.TorusGeometry(1.5,.12,8,32),hiM);micHi.rotation.x=Math.PI/2;micHi.position.set(0,19.7,1.2);robot.add(micHi);
const spkHi=new T.Mesh(new T.PlaneGeometry(5.8,4.4),new T.MeshBasicMaterial({color:0xffb547,transparent:true,opacity:0,blending:T.AdditiveBlending,depthWrite:false}));spkHi.position.set(0,9,3.4);robot.add(spkHi);
const waves=[0,1,2].map(()=>{const m=new T.Mesh(new T.RingGeometry(.9,1,32),new T.MeshBasicMaterial({color:0xffb547,transparent:true,opacity:0,side:2}));m.position.set(0,9,3.5);robot.add(m);return m});
// logic
const st=t=>({z:8*ss(7.4,9.4,t),y:.6*ss(10.9,11.9,t)-.6*ss(12.4,13.4,t)});
const KF=[[5,[29.4,15,42.9],[0,11,0]],[6.2,[24,22,34],[0,15,0]],[9.5,[28,14,40],[0,10,0]],[15,[28,14,40],[0,10,0]],[16,[0,12,32],[0,10.5,0]],[19.6,[3,12,31],[0,10.5,0]],[21.8,[0,24,80],[0,21,0]],[26,[0,24,80],[0,21,0]],[28.4,[16,16,52],[0,10.5,0]],[30,[11,14,48],[0,10.5,0]]];
const lv=(a,b,u)=>a.map((x,i)=>x+(b[i]-x)*u);
function camAt(t){if(t<5){const a=-.85+1.45*ss(0,5,t);return[[52*Math.sin(a),15,52*Math.cos(a)],[0,11,0]]}
 for(let i=0;i<KF.length-1;i++)if(t<=KF[i+1][0]){const u=ss(KF[i][0],KF[i+1][0],t);return[lv(KF[i][1],KF[i+1][1],u),lv(KF[i][2],KF[i+1][2],u)]}
 const k=KF[KF.length-1];return[k[1],k[2]]}
const BUB=[[5.9,7.5,'“Move forward”'],[10.2,11.6,'“Left”'],[11.9,13.3,'“Right”'],[13.5,14.8,'“Stop”']];
const TT=[[0,5,'TaskBuddy AI','Voice-Controlled Personal Assistant Robot'],[5.2,10,'Voice Control',''],[10.2,15,'Simple Voice Commands',''],[15.2,20,'Daily Reminders',''],[21,26,'Planned Components','']];
let t=0,play=true,wa=[0,0],last=performance.now(),prev=0,snd=false,ac=null;
function beep(){if(!snd||!ac)return;[[880,0],[660,.22]].forEach(([f,d])=>{const o=ac.createOscillator(),g=ac.createGain();o.frequency.value=f;o.connect(g);g.connect(ac.destination);const n=ac.currentTime+d;g.gain.setValueAtTime(.0001,n);g.gain.exponentialRampToValueAtTime(.15,n+.02);g.gain.exponentialRampToValueAtTime(.0001,n+.2);o.start(n);o.stop(n+.22)})}
const say=(x,p=1,r=1)=>{if(!snd||!window.speechSynthesis)return;speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(x);u.pitch=p;u.rate=r;u.lang='en-US';speechSynthesis.speak(u)};
const EV=[[.8,'TaskBuddy A I. Your voice controlled assistant robot.',1,1],[6.1,'Move forward',.7,1],[10.3,'Left',.7,1],[12,'Right',.7,1],[13.6,'Stop',.7,1],[16.4],[16.9,'Reminder. Study at 7 P M.',1.8,.95],[21.6,'Planned parts: ESP32, voice module, motor driver, two motors, speaker, and battery.',1,1.12],[28.3,'Design, approval, build. Currently in the design stage.',1,1]];
let off=0,drag=false,lx=0;
const v3=new T.Vector3();
function frame(now){const dt=Math.min(.05,(now-last)/1e3);last=now;
 if(play){t+=dt;if(t>=30){t=0;wa=[0,0]}}
 if(play)EV.forEach(e=>{if(prev<e[0]&&t>=e[0])e[0]===16.4?beep():say(e[1],e[2],e[3])});prev=t;
 const s=st(t),s2=st(t+.03),v=(s2.z-s.z)/.03,om=(s2.y-s.y)/.03;
 robot.position.z=s.z;robot.rotation.y=s.y;
 if(play){wa[0]+=(v-om*6.6)/3*dt;wa[1]+=(v+om*6.6)/3*dt}
 wheels[0].userData.p.rotation.x=wa[0];wheels[1].userData.p.rotation.x=wa[1];
 // explode
 const ex=ss(20.3,22.5,t)*(1-ss(26,28,t)),lab=ss(22.2,23.2,t)*(1-ss(25.6,26.3,t));
 robot.position.y=8*ex;
 comps.forEach(c=>c.g.position.set(...lv(c.a,c.e,ex)));
 wheels.forEach(w=>w.position.set(...lv(w.userData.a,w.userData.e,ex)));
 shell.position.z=16*ex;rear.position.z=-14*ex;
 const al=1-.85*ex;shellMats.forEach(m=>{m.transparent=true;m.opacity=al;m.depthWrite=al>.95});edges.material.opacity=.7*ex;
 // expressions
 const listen=win(t,5.4,7.4,.2)+win(t,10,14.8,.3),happy=win(t,16.2,19.8,.3);
 let bl=1,ph=t%3.6;if(ph<.14)bl=1-Math.sin(ph/.14*Math.PI)*.9;
 eyes.forEach(e=>e.scale.set(1,(1.25+.2*listen-.7*happy)*bl,1));
 const stop=win(t,13.5,14.4,.1);
 stM.color.setHex(stop>.5?0xff4444:(listen>.5&&Math.sin(t*10)>0)?0xffb547:0x44ff88);
 // highlights
 const mh=win(t,5.2,8,.3);hiM.opacity=mh*(.6+.4*Math.sin(t*8));micHi.scale.setScalar(1+.15*Math.sin(t*8));
